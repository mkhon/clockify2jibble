# Clockify: Profile settings -> API -> Generate (key of a workspace admin/owner)
CLOCKIFY_API_KEY=
# Optional: only if you have several workspaces (the export lists them)
CLOCKIFY_WORKSPACE_ID=
# Optional: regional workspaces, e.g. https://euc1.clockify.me/api/v1
CLOCKIFY_BASE_URL=
# Jibble: Organization settings -> API Credentials -> New secret (owner only)
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
